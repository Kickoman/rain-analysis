# Example nginx location block for serving the backend under a path
# prefix of an existing HTTPS server block. Copy into your site config
# (or /etc/nginx/snippets/ and include it), adjusting:
#   - the prefix (/rain-api here) — must match the ROOT_PATH the
#     container runs with (see docker-compose.yml)
#   - the port — must match BACKEND_PORT
#
# The trailing slash on proxy_pass strips the prefix before the request
# reaches the app.

location = /rain-api {
    return 301 /rain-api/;
}

location /rain-api/ {
    proxy_pass         http://127.0.0.1:7010/;
    proxy_redirect     off;
    proxy_http_version 1.1;
    proxy_set_header   Host $host;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
}
