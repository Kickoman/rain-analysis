# Database
DATABASE_URL=sqlite+aiosqlite:///./rain_analysis.db

# Security (REQUIRED - MUST be set before running!)
# Generate a secure salt with: python -c "import secrets; print(secrets.token_hex(32))"
# This field is mandatory and must be at least 32 characters
API_KEYS_SALT=change-me-in-production-use-secrets-token-hex

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging
LOG_LEVEL=INFO

# Application
APP_TITLE=Rain Analysis API
APP_VERSION=0.1.0
