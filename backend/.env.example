# Database
DATABASE_URL=sqlite+aiosqlite:///./rain_analysis.db

# Security (REQUIRED - must be changed before running!)
# Generate a secure salt with: python -c "import secrets; print(secrets.token_hex(32))"
#
# NOTE: The value below is a placeholder that the application will reject at startup.
# This is intentional - it forces you to generate your own secure value before deployment.
API_KEYS_SALT=change-me-in-production-use-secrets-token-hex

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging
LOG_LEVEL=INFO

# Application
APP_TITLE=Rain Analysis API
APP_VERSION=0.1.0

# ML Models
# Directory containing trained model pickle files (.pkl)
# Relative to backend/ directory or absolute path
MODELS_DIR=../models
