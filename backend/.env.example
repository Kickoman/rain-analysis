# Database
DATABASE_URL=sqlite+aiosqlite:///./rain_analysis.db

# Security
# IMPORTANT: This placeholder value is intentionally rejected by the validator!
# The app will refuse to start with this value to prevent accidental deployment
# with insecure credentials. Generate a secure salt with:
#   python -c 'import secrets; print(secrets.token_hex(32))'
API_KEYS_SALT=change-me-in-production-use-secrets-token-hex

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging
LOG_LEVEL=INFO

# Application
APP_TITLE=Rain Analysis API
APP_VERSION=0.1.0

# ML Models
# Directory containing trained model pickle files (.pkl)
# Relative to backend/ directory or absolute path
MODELS_DIR=../models
